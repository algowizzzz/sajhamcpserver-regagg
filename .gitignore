# ============================================================================
# SAJHA MCP Server v3 — Git Ignore
# ============================================================================

# ── Database (SQLite files auto-created on startup, never checked in) ────
data/*.db
data/*.db-journal
data/*.db-wal
*.sqlite
*.sqlite3

# ── Logs ─────────────────────────────────────────────────────────────────
logs/
*.log

# ── Temp ─────────────────────────────────────────────────────────────────
temp/
tmp/

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl
.venv/
venv/
env/

# ── IDE ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ── Environment (secrets) ───────────────────────────────────────────────
.env
.env.local
.env.production

# ── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Alembic ──────────────────────────────────────────────────────────────
alembic/versions/*.pyc

# ── Test ─────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
# RegAgg runtime artifacts — never commit corpus/state
data/sajha.db*
logs/
verification_report.md
data/notepads/
tests/ui/test-results/
data/sajha_uitest.db*

# The canonical raw archive: 5.4 GB of original HTML/PDF alongside the
# converted markdown. Git is the wrong store for it — tracking it had .git at
# 1.3 GB and the next commit would have been 4 GB, past GitHub's 2 GB push
# limit. `data/markdown/` (the agent-consumable projection) stays tracked; the
# archive is rebuilt by re-collecting, and belongs in a real backup.
data/web_aggregator/
