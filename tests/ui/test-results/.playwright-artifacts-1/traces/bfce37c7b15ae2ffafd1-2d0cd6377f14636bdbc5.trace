ius:7px;background:var(--blue);color:#fff;\n       display:grid;place-items:center;font-size:12px;font-weight:700}\n  .nav{display:flex;gap:4px}\n  .nav button{padding:6px 13px;border-radius:8px;font-weight:550;color:var(--ink2);font-size:13px}\n  .nav .on{background:var(--blue-soft);color:var(--blue)}\n  .spacer{flex:1}\n  .btn{border:1px solid var(--line);border-radius:8px;padding:6px 13px;background:var(--surface);\n       font-weight:550;display:inline-flex;align-items:center;gap:6px;font-size:12.5px}\n  .btn:hover{border-color:var(--blue);color:var(--blue)}\n  .btn.primary{background:var(--blue);color:#fff;border-color:var(--blue)}\n  .btn.sm{padding:3px 9px;font-size:11.5px;border-radius:7px}\n  select{font:inherit;color:var(--ink);background:var(--surface);border:1px solid var(--line);\n       border-radius:8px;padding:5px 9px}\n  .page{max-width:1240px;margin:0 auto;padding:18px 24px 80px}\n  .view{display:none}.view.on{display:block}\n\n  .tiles{display:grid;grid-template-columns:repeat(5,1fr);gap:11px;margin-bottom:16px}\n  .tile{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);\n       padding:11px 14px;box-shadow:var(--shadow)}\n  .tile b{font-size:20px;font-weight:680;display:block;letter-spacing:-.02em}\n  .tile span{color:var(--muted);font-size:11.5px}\n  .up{color:var(--green)}.warn{color:var(--amber)}.bad{color:var(--red)}\n\n  .pill{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:600;\n       border-radius:6px;padding:2px 8px;white-space:nowrap}\n  .pill.ok{background:var(--green-soft);color:var(--green)}\n  .pill.ok_empty{background:var(--amber-soft);color:var(--amber)}\n  .pill.stale,.pill.partial{background:var(--amber-soft);color:var(--amber)}\n  .pill.failed,.pill.fail{background:var(--red-soft);color:var(--red)}\n  .pill.never_run,.pill.block{background:var(--grey-soft);color:var(--ink2)}\n  .pill.running{background:var(--blue-soft);color:var(--blue)}\n\n  .region{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);\n       box-shadow:var(--shadow);margin-bottom:11px;overflow:hidden}\n  .rhead{display:flex;align-items:center;gap:12px;padding:13px 16px;cursor:pointer;user-select:none}\n  .rhead:hover{background:var(--surface2)}\n  .caret{width:16px;color:var(--muted);transition:transform .15s;display:inline-block}\n  .open>.rhead .caret,.inst.open .ihead .caret,.srct.open .shead .caret{transform:rotate(90deg)}\n  .rname{font-weight:650;font-size:13.5px;min-width:130px}\n  .rollup{display:flex;gap:18px;color:var(--ink2);font-size:12px;flex-wrap:wrap}\n  .rollup b{color:var(--ink);font-weight:600}\n  .rbody{display:none;border-top:1px solid var(--line2)}\n  .open>.rbody{display:block}\n  .inst{border-bottom:1px solid var(--line2)}\n  .inst:last-child{border-bottom:none}\n  .ihead{display:grid;grid-template-columns:22px minmax(170px,1.3fr) 1fr 1fr 130px 110px 70px;\n       gap:8px;align-items:center;padding:10px 16px;cursor:pointer;font-size:12.5px}\n  .ihead:hover{background:var(--surface2)}\n  .iname{font-weight:600}\n  .iname .full{display:block;color:var(--muted);font-weight:400;font-size:11px}\n  .cnum{color:var(--ink2);font-variant-numeric:tabular-nums}\n  .cnum b{color:var(--ink)}\n  .cnum .new{color:var(--green);font-weight:600}\n  .ibody{display:none;background:var(--surface2);padding:2px 16px 10px 46px}\n  .inst.open .ibody{display:block}\n  .srct{border:1px solid var(--line);border-radius:8px;background:var(--surface);\n       margin-top:8px;overflow:hidden}\n  .shead{display:flex;align-items:center;gap:10px;padding:8px 12px;cursor:pointer;font-size:12.5px}\n  .shead:hover{background:var(--surface2)}\n  .sico{width:24px;height:24px;border-radius:6px;display:grid;place-items:center;font-size:12px}\n  .sico.web{background:var(--blue-soft)}.sico.pdf{background:var(--red-soft)}\n  .smeta{color:var(--muted);font-size:11.5px}\n  .sbody{display:none;border-top:1px solid var(--line2);padding:2px 12px 8px}\n  .srct.open .sbody{display:block}\n  .doc{display:flex;align-items:center;gap:8px;padding:6px 4px;border-bottom:1px solid var(--line2);\n       cursor:pointer;border-radius:6px;font-size:12px}\n  .doc:last-child{border-bottom:none}\n  .doc:hover{background:var(--blue-soft)}\n  .dt{font-weight:550;color:var(--blue);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:58%}\n  .tag{font-size:10px;border:1px solid var(--line);border-radius:5px;padding:1px 6px;color:var(--ink2);white-space:nowrap}\n  .tag.v{background:var(--amber-soft);border-color:transparent;color:var(--amber);font-weight:600}\n  .tag.sup{background:var(--red-soft);border-color:transparent;color:var(--red);font-weight:600}\n  .tag.pdf{background:var(--red-soft);border-color:transparent;color:var(--red)}\n  .dmeta{color:var(--muted);font-size:11px;margin-left:auto;white-space:nowrap}\n  .more{color:var(--blue);font-size:11.5px;padding:6px 4px;font-weight:550;cursor:pointer}\n\n  /* changes */\n  .fbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:13px;\n       background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);\n       box-shadow:var(--shadow);padding:9px 12px}\n  .fchips{display:flex;gap:5px;flex-wrap:wrap}\n  .chip{border:1px solid var(--line);background:var(--surface2);border-radius:16px;\n       padding:3px 11px;font-size:11.5px;color:var(--ink2);font-weight:550}\n  .chip.on{background:var(--blue);border-color:var(--blue);color:#fff}\n  .fdate{color:var(--muted);font-size:11.5px;display:inline-flex;align-items:center;gap:5px}\n  .fdate input{font:inherit;color:var(--ink);background:var(--surface2);\n       border:1px solid var(--line);border-radius:7px;padding:3px 7px}\n  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);\n       box-shadow:var(--shadow);padding:12px 15px;margin-bottom:9px;display:grid;\n       grid-template-columns:104px 1fr auto;gap:13px;align-items:start}\n  .badge{font-size:10px;font-weight:700;border-radius:6px;padding:3px 7px;text-align:center;letter-spacing:.03em}\n  .badge.new{background:var(--green-soft);color:var(--green)}\n  .badge.revised{background:var(--amber-soft);color:var(--amber)}\n  .badge.superseded{background:var(--red-soft);color:var(--red)}\n  .badge.deadline{background:var(--blue-soft);color:var(--blue)}\n  .breg{font-size:10.5px;color:var(--muted);margin-top:4px;text-align:center}\n  .card h4{font-size:13px;font-weight:600}\n  .card p{color:var(--ink2);font-size:12px;margin-top:2px}\n  .day{margin:16px 0 8px;font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;\n       color:var(--muted);font-weight:650}\n\n  /* runs */\n  .live{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);\n       box-shadow:var(--shadow);padding:13px 16px;margin-bottom:14px}\n  .pulse{width:8px;height:8px;border-radius:50%;background:var(--blue);display:inline-block;\n       animation:pu 1.4s infinite;margin-right:8px}\n  @keyframes pu{0%,100%{opacity:1}50%{opacity:.35}}\n  table{border-collapse:collapse;width:100%;background:var(--surface);border:1px solid var(--line);\n       border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}\n  th{font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);\n       text-align:left;padding:8px 12px;background:var(--surface2);border-bottom:1px solid var(--line2)}\n  td{padding:7px 12px;border-bottom:1px solid var(--line2);font-size:12px;color:var(--ink2)}\n  tr:last-child td{border-bottom:none}\n  td b{color:var(--ink)}\n  .num{font-variant-numeric:tabular-nums;text-align:right}\n  th.num{text-align:right}\n  h3.sec{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin:16px 0 8px}\n\n  /* drawer */\n  .scrim{position:fixed;inset:0;background:rgba(10,14,20,.45);z-index:40;display:none}\n  .scrim.show{display:block}\n  .drawer{position:fixed;top:0;right:-760px;width:min(720px,96vw);height:100%;z-index:50;\n       background:var(--surface);box-shadow:-12px 0 40px rgba(0,0,0,.25);\n       transition:right .2s ease;display:flex;flex-direction:column}\n  .drawer.show{right:0}\n  .drhead{padding:16px 20px 0;border-bottom:1px solid var(--line);position:relative}\n  .drtitle{font-size:15px;font-weight:650;margin-bottom:3px;padding-right:36px}\n  .drsub{color:var(--muted);font-size:11.5px;margin-bottom:10px}\n  .drclose{position:absolute;top:12px;right:14px;font-size:18px;color:var(--muted);padding:6px}\n  .tabs{display:flex;gap:2px}\n  .tab{padding:7px 13px;font-weight:550;font-size:12px;color:var(--ink2);\n       border-bottom:2px solid transparent}\n  .tab.on{color:var(--blue);border-color:var(--blue)}\n  .drbody{flex:1;overflow:auto;padding:16px 20px}\n  .drbody pre{background:var(--surface2);border:1px solid var(--line2);border-radius:8px;\n       padding:12px;font-size:11.5px;overflow:auto;color:var(--ink2);white-space:pre-wrap;\n       font-family:ui-monospace,Menlo,monospace}\n  /* rendered document (rich markdown) */\n  .md{font-size:13.5px;line-height:1.65;color:var(--ink)}\n  .md h1{font-size:19px;margin:4px 0 10px;line-height:1.3}\n  .md h2{font-size:16px;margin:18px 0 7px;padding-bottom:4px;border-bottom:1px solid var(--line2)}\n  .md h3{font-size:14px;margin:14px 0 5px}\n  .md h4,.md h5{font-size:13px;margin:12px 0 4px}\n  .md p{margin:7px 0;color:var(--ink2)}\n  .md li{margin:3px 0;color:var(--ink2)}\n  .md ul,.md ol{padding-left:22px;margin:6px 0}\n  .md a{color:var(--blue)}\n  .md blockquote{border-left:3px solid var(--line);margin:8px 0;padding:2px 12px;color:var(--muted)}\n  .md code{background:var(--surface2);border:1px solid var(--line2);border-radius:4px;\n       padding:0 4px;font-family:ui-monospace,Menlo,monospace;font-size:12px}\n  .md pre code{border:none;background:none;padding:0}\n  .md table{border-collapse:collapse;margin:10px 0;width:auto;min-width:60%;box-shadow:none}\n  .md th,.md td{border:1px solid var(--line);padding:5px 10px;font-size:12.5px;text-align:left}\n  .md th{background:var(--surface2);color:var(--ink)}\n  .md hr{border:none;border-top:1px solid var(--line);margin:14px 0}\n  .md img{max-width:100%}\n  .kv{display:grid;grid-template-columns:130px 1fr;gap:4px 12px;font-size:12px}\n  .kv .k{color:var(--muted)}\n  .kv .v{color:var(--ink);word-break:break-all}\n  .dl{color:var(--green)}.rm{color:var(--red)}\n  /* overview (first-run simple mode) */\n  .headline{font-size:15.5px;font-weight:600;line-height:1.5;margin-bottom:16px;\n       padding:14px 18px;background:var(--surface);border:1px solid var(--line);\n       border-left:3px solid var(--blue);border-radius:var(--radius);box-shadow:var(--shadow)}\n  .simple-card{background:var(--surface);border:1px solid var(--line);\n       border-radius:var(--radius);box-shadow:var(--shadow);padding:14px 16px;margin-bottom:14px}\n  .simple-head{display:flex;align-items:center;gap:10px;margin-bottom:10px;font-size:13.5px}\n  .prio{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:700;\n       border-radius:6px;padding:2px 8px;letter-spacing:.02em}\n  .prio.Critical{background:var(--red-soft);color:var(--red)}\n  .prio.High{background:var(--amber-soft);color:var(--amber)}\n  .prio.Medium{background:var(--blue-soft);color:var(--blue)}\n  .prio.Low,.prio.Informational{background:var(--grey-soft);color:var(--muted)}\n  .pitem{display:flex;align-items:flex-start;gap:10px;padding:9px 4px;\n       border-bottom:1px solid var(--line2);cursor:pointer}\n  .pitem:last-child{border-bottom:none}\n  .pitem:hover{background:var(--blue-soft)}\n  .pitem .why{color:var(--muted);font-size:11px;margin-top:2px}\n  .dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:7px}\n  .dot.ok{background:var(--green)}.dot.bad{background:var(--amber)}\n  /* explorer tree */\n  .fsrow{display:flex;align-items:center;gap:7px;padding:4px 8px;border-radius:6px;\n       cursor:pointer;font-size:12.5px;color:var(--ink2)}\n  .fsrow:hover{background:var(--blue-soft)}\n  .fsrow .fsname{font-weight:550;color:var(--ink)}\n  .fsrow.file .fsname{color:var(--blue);font-weight:500}\n  .fsrow .fsmeta{margin-left:auto;color:var(--muted);font-size:11px;font-variant-numeric:tabular-nums}\n  .fskids{margin-left:18px;border-left:1px solid var(--line2);padding-left:6px;display:none}\n  .fsopen>.fskids{display:block}\n  .fsopen>.fsrow .caret{transform:rotate(90deg)}\n  /* modal */\n  .modal{position:fixed;inset:0;z-index:60;display:none;place-items:center;\n       background:rgba(10,14,20,.45)}\n  .modal.show{display:grid}\n  .modal-card{background:var(--surface);border-radius:14px;box-shadow:0 24px 80px rgba(0,0,0,.35);\n       width:520px;max-width:94vw;padding:20px;max-height:88vh;overflow:auto}\n  .mrow{display:flex;gap:10px;margin-top:9px;align-items:flex-start}\n  .mrow label{width:92px;color:var(--muted);font-size:12px;padding-top:7px;flex-shrink:0}\n  .mrow input,.mrow select,.mrow textarea{flex:1;font:inherit;color:var(--ink);\n       background:var(--surface2);border:1px solid var(--line);border-radius:7px;\n       padding:6px 9px;width:100%}\n  .toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(80px);\n       background:var(--ink);color:var(--bg);border-radius:10px;padding:9px 16px;font-size:12.5px;\n       z-index:70;transition:transform .25s}\n  .toast.show{transform:translateX(-50%) translateY(0)}\n  .empty{color:var(--muted);font-size:12px;padding:10px 4px}\n  @media (max-width:900px){.tiles{grid-template-columns:repeat(2,1fr)}\n    .ihead{grid-template-columns:20px 1fr 90px 60px}.hide-sm{display:none}}\n\n  /* home: two model cards */\n  .home-hero{margin:26px 0 18px;font-size:21px;font-weight:700}\n  .home-sub{color:var(--muted);font-size:13px;margin:-10px 0 22px}\n  .mcards{display:grid;grid-template-columns:1fr 1fr;gap:18px}\n  @media(max-width:820px){.mcards{grid-template-columns:1fr}}\n  .mcard{background:var(--surface);border:1px solid var(--line);border-radius:14px;\n    padding:22px;cursor:pointer;transition:box-shadow .15s,transform .15s;position:relative}\n  .mcard:hover{box-shadow:0 6px 22px rgba(15,40,80,.10);transform:translateY(-2px)}\n  .mcard .mic{font-size:26px}\n  .mcard h2{margin:10px 0 4px;font-size:17px}\n  .mcard p{color:var(--muted);font-size:12.5px;margin:0 0 14px;line-height:1.5}\n  .mcard .mstats{display:flex;gap:22px;flex-wrap:wrap}\n  .mcard .mstats b{display:block;font-size:19px}\n  .mcard .mstats span{font-size:11px;color:var(--muted)}\n  .mcard .go{position:absolute;top:20px;right:20px;color:var(--blue);font-weight:600;font-size:13px}\n  /* news page */\n  .chips{display:flex;gap:6px;flex-wrap:wrap}\n  .chip{border:1px solid var(--line);background:var(--surface);border-radius:999px;\n    padding:3px 11px;font-size:11.5px;cursor:pointer;color:var(--ink)}\n  .chip.on{background:var(--blue);border-color:var(--blue);color:#fff}\n  .story{display:flex;gap:12px;padding:11px 4px;border-bottom:1px solid var(--line)}\n  .story:last-child{border-bottom:0}\n  .story .n{color:var(--muted);font-size:12px;width:18px;flex:none;padding-top:2px}\n  .story h4{margin:0 0 3px;font-size:13.5px;font-weight:600;cursor:pointer}\n  .story h4:hover{color:var(--blue)}\n  .story .meta{font-size:11px;color:var(--muted);margin-bottom:3px}\n  .story .sum{font-size:12px;color:var(--ink);opacity:.85;line-height:1.45}\n  .tbadge{display:inline-block;border-radius:5px;padding:1px 7px;font-size:10px;\n    font-weight:700;margin-right:7px;vertical-align:1px}\n  .t-credit{background:#fde8e8;color:#b42318}.t-rates{background:#e8edfd;color:#1d3fb4}\n  .t-banking{background:#e6f4ea;color:#137333}.t-economy{background:#fef3e2;color:#a05a00}\n  .t-deals{background:#f3e8fd;color:#7a1fa2}.t-energy{background:#e2f5f5;color:#0a7c74}\n  .t-markets{background:#eef1f5;color:#3c4a5d}.t-general{background:#eef1f5;color:#6b7686}\n  [data-theme=\"dark\"] .t-credit{background:#3a1616;color:#ff9e91}\n  [data-theme=\"dark\"] .t-rates{background:#16203a;color:#9eb5ff}\n  [data-theme=\"dark\"] .t-banking{background:#12291a;color:#7fd99a}\n  [data-theme=\"dark\"] .t-economy{background:#33250e;color:#ffc97a}\n  [data-theme=\"dark\"] .t-deals{background:#2a1633;color:#dba7f5}\n  [data-theme=\"dark\"] .t-energy{background:#0e2b29;color:#7fe0d8}\n  [data-theme=\"dark\"] .t-markets,[data-theme=\"dark\"] .t-general{background:#232a33;color:#aeb9c8}\n  .news-grid{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:16px}\n  @media(max-width:1000px){.news-grid{grid-template-columns:1fr}}\n  .npanel{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 16px}\n  .npanel h3{margin:0 0 8px;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}\n  .srcrow{display:flex;justify-content:space-between;font-size:12px;padding:3px 0}\n  .volbar{display:flex;align-items:flex-end;gap:3px;height:52px;margin-top:6px}\n  .volbar>div{flex:1;background:var(--blue);opacity:.75;border-radius:2px 2px 0 0;min-height:2px;cursor:pointer}\n  .volbar>div.sel{opacity:1;outline:2px solid var(--blue)}\n  .daynav{display:flex;gap:6px;align-items:center}\n\n  /* ── executive pages: home + the two lane deep-dives ── */\n  .xhero{margin:22px 0 6px;font-size:22px;font-weight:700;letter-spacing:-.02em}\n  .xsub{color:var(--muted);font-size:13px;margin-bottom:20px;max-width:820px;line-height:1.55}\n  .xdate{float:right;color:var(--muted);font-size:11px;text-align:right;line-height:1.45}\n  .xtiles{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin:0 0 16px}\n  @media(max-width:900px){.xtiles{grid-template-columns:repeat(3,1fr)}}\n  .xcard{background:var(--surface);border:1px solid var(--line);border-radius:12px;\n    padding:15px 17px;margin-bottom:14px;box-shadow:var(--shadow)}\n  .xcard h3{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);\n    margin-bottom:11px;font-weight:600}\n  .xcard h3 .plain{text-transform:none;letter-spacing:0;font-weight:400}\n  .xgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n  @media(max-width:900px){.xgrid{grid-template-columns:1fr}}\n  .xbar{display:grid;grid-template-columns:var(--lw,140px) 1fr 56px;gap:8px;align-items:center;\n    margin:6px 0;font-size:12.5px}\n  .xbar .lbl{color:var(--ink2);text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n  .xbar .lbl b{margin-right:5px;color:var(--c)}\n  .xbar .track{display:block;height:13px}\n  .xbar .fill{display:block;position:relative;height:13px;border-radius:0 4px 4px 0;\n    background:var(--c,var(--blue))}\n  .xbar .sub{position:absolute;right:0;top:0;height:13px;background:var(--muted);\n    border-radius:0 4px 4px 0;box-shadow:-2px 0 0 var(--surface)}\n  .xbar .val{font-variant-numeric:tabular-nums;font-weight:650;font-size:12px}\n  .xbar.clickable{cursor:pointer}\n  .xbar.clickable:hover .lbl{color:var(--blue)}\n  .xlegend{font-size:11px;color:var(--muted);display:flex;gap:14px;margin-bottom:7px}\n  .xlegend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;\n    vertical-align:-1px;font-style:normal}\n  .xcols{display:flex;align-items:flex-end;gap:7px;margin-top:4px}\n  .xcols .c{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;\n    gap:3px;cursor:pointer}\n  .xcols .c:hover .bar{opacity:.75}\n  .xcols .bar{width:100%;background:var(--blue);border-radius:4px 4px 0 0;min-height:3px}\n  .xcols .v{font-size:11px;font-weight:650;font-variant-numeric:tabular-nums}\n  .xcols .d{font-size:9.5px;color:var(--muted)}\n  .xnote{font-size:11px;color:var(--muted);margin-top:9px;line-height:1.5}\n  .xlist{list-style:none}\n  .xlist li{padding:6px 0;border-bottom:1px solid var(--line);font-size:12.5px;cursor:pointer}\n  .xlist li:last-child{border-bottom:0}\n  .xlist li:hover b{color:var(--blue)}\n  .xlist .sc{float:right;font-weight:700;color:var(--red);font-variant-numeric:tabular-nums}\n  .xlist .rz{display:block;color:var(--muted);font-size:11px;margin-top:2px}\n  .xstory{border-left:3px solid var(--c,var(--red));padding:7px 0 7px 11px;margin:8px 0;\n    background:var(--surface2);border-radius:0 8px 8px 0;cursor:pointer}\n  .xstory:hover b{color:var(--blue)}\n  .xstory b{font-size:12.5px}\n  .xstory .m{font-size:10.5px;color:var(--muted);margin-top:3px}\n  /* the two lane cards on home */\n  .lanes{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}\n  @media(max-width:900px){.lanes{grid-template-columns:1fr}}\n  .lane{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px;\n    cursor:pointer;transition:box-shadow .15s,transform .15s;position:relative;box-shadow:var(--shadow)}\n  .lane:hover{box-shadow:0 6px 22px rgba(15,40,80,.10);transform:translateY(-2px);border-color:var(--blue)}\n  .lane .ic{font-size:24px}\n  .lane h2{margin:9px 0 4px;font-size:16.5px}\n  .lane p{color:var(--muted);font-size:12.5px;margin:0 0 13px;line-height:1.5}\n  .lane .st{display:flex;gap:20px;flex-wrap:wrap}\n  .lane .st b{display:block;font-size:18px;letter-spacing:-.02em}\n  .lane .st span{font-size:10.5px;color:var(--muted)}\n  .lane .go{position:absolute;top:18px;right:18px;color:var(--blue);font-weight:600;font-size:12.5px}\n  /* \"where to go next\" launchers */\n  .jump{display:grid;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));gap:9px}\n  .jump a{display:block;border:1px solid var(--line);border-radius:10px;padding:11px 13px;\n    background:var(--surface2);cursor:pointer;color:var(--ink)}\n  .jump a:hover{border-color:var(--blue);background:var(--blue-soft)}\n  .jump a b{display:block;font-size:12.5px;margin-bottom:2px}\n  .jump a span{font-size:11px;color:var(--muted);line-height:1.4;display:block}\n  .navsep{width:1px;height:20px;background:var(--line);margin:0 4px;align-self:center}\n\n  /* ── two-level navigation ── */\n  .top{height:52px}\n  .nav button{padding:6px 12px}\n  .lanebar{background:var(--surface);border-bottom:1px solid var(--line);\n    padding:0 24px;height:42px;display:none;align-items:center;gap:3px;\n    position:sticky;top:52px;z-index:29}\n  .lanebar.on{display:flex}\n  .lanebar .who{font-weight:650;font-size:12.5px;margin-right:14px;display:flex;\n    align-items:center;gap:6px;white-space:nowrap}\n  .lanebar button{padding:5px 11px;border-radius:7px;font-size:12.5px;color:var(--ink2);\n    font-weight:550;white-space:nowrap}\n  .lanebar button:hover{background:var(--surface2);color:var(--ink)}\n  .lanebar button.on{background:var(--blue-soft);color:var(--blue)}\n  .lanebar .scope{margin-left:auto;font-size:11px;color:var(--muted);white-space:nowrap}\n  /* first-time orientation */\n  .intro{background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--blue);\n    border-radius:0 10px 10px 0;padding:11px 15px;margin:0 0 16px;font-size:12.5px;\n    color:var(--ink2);line-height:1.55;display:flex;gap:10px;align-items:flex-start}\n  .intro b{color:var(--ink)}\n  .intro .x{margin-left:auto;color:var(--muted);cursor:pointer;font-size:15px;line-height:1;\n    padding:0 2px;flex:none}\n  .ptitle{font-size:17px;font-weight:680;letter-spacing:-.02em;margin:2px 0 3px}\n  .psub{color:var(--muted);font-size:12.5px;margin-bottom:14px;max-width:760px;line-height:1.5}\n  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:16px}\n  @media(max-width:900px){.steps{grid-template-columns:1fr}}\n  .step-c{background:var(--surface2);border:1px solid var(--line);border-radius:10px;padding:12px 14px}\n  .step-c b{display:block;font-size:12.5px;margin-bottom:3px}\n  .step-c span{font-size:11.5px;color:var(--muted);line-height:1.45;display:block}\n  .step-c em{font-style:normal;color:var(--blue);font-weight:600;font-size:11px;\n    display:block;margin-top:6px;cursor:pointer}\n\n  /* ── auth gate ── */\n  #authGate{position:fixed;inset:0;background:var(--bg);z-index:100;display:none;\n    align-items:center;justify-content:center;padding:20px}\n  #authGate.on{display:flex}\n  .authbox{background:var(--surface);border:1px solid var(--line);border-radius:14px;\n    padding:26px 28px;width:100%;max-width:390px;box-shadow:0 8px 30px rgba(15,40,80,.12)}\n  .authbox h2{font-size:17px;margin-bottom:3px}\n  .authbox .sub{color:var(--muted);font-size:12.5px;margin-bottom:16px;line-height:1.5}\n  .authbox label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n    color:var(--muted);margin:10px 0 4px}\n  .authbox input{width:100%;font:inherit;color:var(--ink);background:var(--surface2);\n    border:1px solid var(--line);border-radius:8px;padding:8px 11px}\n  .authbox input:focus{outline:none;border-color:var(--blue)}\n  .authbox .go{width:100%;margin-top:16px;background:var(--blue);color:#fff;border-radius:9px;\n    padding:9px;font-weight:650;font-size:13px}\n  .authbox .alt{margin-top:12px;font-size:12px;color:var(--muted);text-align:center}\n  .authbox .alt b{color:var(--blue);cursor:pointer}\n  .autherr{margin-top:12px;background:var(--red-soft);color:var(--red);border-radius:8px;\n    padding:8px 11px;font-size:12px;display:none}\n  .autherr.on{display:block}\n  /* ── personas tab ── */\n  .pgrid{display:grid;grid-template-columns:300px 1fr;gap:16px}\n  @media(max-width:900px){.pgrid{grid-template-columns:1fr}}\n  .plist .pitem{border:1px solid var(--line);border-radius:10px;padding:10px 13px;margin-bottom:8px;\n    cursor:pointer;background:var(--surface)}\n  .plist .pitem.on{border-color:var(--blue);box-shadow:0 0 0 1px var(--blue)}\n  .plist .pitem b{font-size:13px;display:block}\n  .plist .pitem span{font-size:11px;color:var(--muted)}\n  .pform label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.05em;\n    color:var(--muted);margin:12px 0 4px}\n  .pform input,.pform textarea,.pform select{width:100%;font:inherit;color:var(--ink);\n    background:var(--surface2);border:1px solid var(--line);border-radius:8px;padding:7px 10px}\n  .pform textarea{min-height:110px;font:12px ui-monospace,Menlo,monospace;resize:vertical}\n  .pform .row{display:flex;gap:10px}.pform .row>*{flex:1}\n  .pform .hint{font-size:11px;color:var(--muted);margin-top:4px}\n  .pv{background:var(--surface2);border:1px solid var(--line);border-radius:10px;padding:11px 14px;margin-top:14px}\n  .pv h4{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:6px}\n  .pv .r{font-size:12px;padding:2px 0;color:var(--ink2)}\n  .pv .r b{color:var(--ink)}\n  .whoami{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted)}\n  .whoami b{color:var(--ink)}\n\n  /* ── my day ── */\n  .md-head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin:4px 0 2px}\n  .md-head b{font-size:19px;letter-spacing:-.02em}\n  .md-head .chip{font-size:10px;font-weight:700;color:var(--blue);background:var(--blue-soft);\n    border-radius:5px;padding:2px 8px}\n  .md-head .day{color:var(--muted);font-size:11.5px;margin-left:auto}\n  .md-upd{border:1px solid var(--line);border-left:3px solid var(--red);border-radius:0 8px 8px 0;\n    background:var(--surface);padding:8px 12px;font-size:12.5px;margin:10px 0}\n  .md-upd b{color:var(--red)}\n  .md-lede{font-size:14px;line-height:1.6;color:var(--ink2);margin:12px 0 16px;max-width:880px}\n  .md-lede b{color:var(--ink)}\n  .md-ev{border-left:3px solid var(--c,var(--muted));background:var(--surface);\n    border-radius:0 9px 9px 0;padding:10px 14px;margin:8px 0;cursor:pointer;\n    border-top:1px solid var(--line);border-right:1px solid var(--line);border-bottom:1px solid var(--line)}\n  .md-ev:hover b{color:var(--blue)}\n  .md-ev b{font-size:13.5px}\n  .md-ev .m{font-size:11px;color:var(--muted);margin-top:3px}\n  .md-ev .m .sev{font-weight:700;color:var(--c)}\n  .md-quiet{border:1px dashed var(--line);border-radius:9px;padding:10px 14px;\n    font-size:12.5px;color:var(--muted);background:var(--surface)}\n  .md-quiet b{color:var(--green)}\n  .md-ledger{margin-top:18px;border-top:1px dashed var(--line);padding-top:10px;\n    font-size:11px;color:var(--muted);line-height:1.6}\n  .md-empty{background:var(--surface);border:1px solid var(--line);border-radius:12px;\n    padding:26px;text-align:center}\n  .md-empty h3{font-size:15px;margin-bottom:6px}\n  .md-empty p{color:var(--muted);font-size:12.5px;margin-bottom:14px}\n  /* ── health ── */\n  .hsec{background:var(--surface);border:1px solid var(--line);border-radius:12px;\n    padding:14px 16px;margin-bottom:14px}\n  .hsec h3{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:10px}\n  .stagebar{display:flex;gap:7px;flex-wrap:wrap}\n  .stagebar span{border:1px solid var(--line);border-radius:8px;padding:6px 11px;\n    font-size:11.5px;background:var(--surface2)}\n  .stagebar b{color:var(--green)}\n  /* ── ask ── */\n  .ask-chip{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--blue);\n    border-radius:999px;padding:5px 13px;font-size:11.5px;color:var(--blue);\n    background:var(--blue-soft);margin-bottom:14px}\n  .ask-box{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px 18px}\n  .ask-box code{background:var(--surface2);padding:1px 6px;border-radius:5px;font-size:11.5px}\n\n  .md-switch{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin:2px 0 6px}\n  .md-switch button{border:1px solid var(--line);border-radius:999px;padding:4px 12px;\n    font-size:12px;background:var(--surface);color:var(--ink2)}\n  .md-switch button.on{background:var(--blue);border-color:var(--blue);color:#fff}\n  .md-switch button:hover{border-color:var(--blue)}\n  .starters{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0}\n  @media(max-width:860px){.starters{grid-template-columns:1fr}}\n  .starter{border:1px solid var(--line);border-radius:11px;padding:13px 15px;\n    background:var(--surface);cursor:pointer;text-align:left}\n  .starter:hover{border-color:var(--blue);background:var(--blue-soft)}\n  .starter b{display:block;font-size:13px;margin-bottom:3px}\n  .starter span{font-size:11.5px;color:var(--muted);line-height:1.45;display:block}\n\n  /* ── small screens: the app is read on phones between meetings ──\n     Every wide thing must either collapse or scroll INSIDE its own box; the\n     page body must never scroll sideways. */\n  @media(max-width:760px){\n    .page{padding:12px 14px 60px}\n    .top{height:auto;flex-wrap:wrap;padding:8px 14px;gap:8px}\n    .nav{flex-wrap:wrap;gap:3px}\n    .nav button{padding:5px 9px;font-size:12px}\n    .lanebar{height:auto;flex-wrap:wrap;padding:8px 14px;position:static}\n    .lanebar .scope{margin-left:0;width:100%}\n    .tiles,.xtiles{grid-template-columns:repeat(2,1fr)}\n    .grid2,.xgrid,.pgrid,.starters,.steps,.lanes,.comps,.mcards{grid-template-columns:1fr}\n    .xbar,.hbar{grid-template-columns:minmax(0,1fr) 2fr 46px}\n    .xbar .lbl,.hbar .lbl{font-size:11px}\n    table{display:block;overflow-x:auto;white-space:nowrap}\n    .fbar{gap:5px}\n    .fbar input,.fbar select{min-width:0;flex:1 1 130px}\n    .drawer{width:100%;max-width:100%}\n    .md-head .day{margin-left:0;width:100%}\n    .form{grid-template-columns:1fr}\n    .form label{text-align:left}\n  }\n  /* a grid child with long content must be allowed to shrink, or it pushes\n     the whole page wider than the screen */\n  .grid2>*,.xgrid>*,.pgrid>*,.tiles>*,.xtiles>*{min-width:0}\n  .view{max-width:100%}\n\n  /* ── desks: every persona at a glance ── */\n  .dk-hero{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin:2px 0 4px}\n  .dk-hero b{font-size:19px;letter-spacing:-.02em}\n  .dk-hero .win{margin-left:auto;color:var(--muted);font-size:11.5px}\n  .dk-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px}\n  @media(max-width:1000px){.dk-grid{grid-template-columns:repeat(2,1fr)}}\n  @media(max-width:760px){.dk-grid{grid-template-columns:1fr}}\n  .dk{border:1px solid var(--line);border-radius:12px;background:var(--surface);\n    padding:14px 16px;cursor:pointer;box-shadow:var(--shadow);position:relative;\n    border-top:3px solid var(--c,var(--line))}\n  .dk:hover{border-color:var(--blue)}\n  .dk h4{font-size:13.5px;margin:0 0 2px}\n  .dk .sub{font-size:10.5px;color:var(--muted);margin-bottom:9px}\n  .dk .counts{display:flex;gap:14px;margin-bottom:9px}\n  .dk .counts div{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}\n  .dk .counts b{display:block;font-size:17px;letter-spacing:-.02em}\n  .dk .top{font-size:12px;line-height:1.45;color:var(--ink2);border-top:1px solid var(--line);\n    padding-top:8px}\n  .dk .top b{color:var(--ink);font-weight:600}\n  .dk .why{font-size:10.5px;color:var(--muted);margin-top:3px}\n  .dk .quiet{font-size:12px;color:var(--green)}\n  .dk-bar{display:flex;align-items:flex-end;gap:4px;height:36px;margin:10px 0 2px}\n  .dk-bar div{flex:1;background:var(--blue);border-radius:2px 2px 0 0;min-height:2px;opacity:.75}\n  .dk-bar div:last-child{opacity:1}\n\n  .md-maybe{display:inline-block;background:var(--amber-soft);color:var(--amber);\n    border-radius:5px;padding:1px 7px;font-size:10px;font-weight:700;margin-left:6px}\n\n  /* ── ask: grounded chat ── */\n  .ask-wrap{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:16px}\n  @media(max-width:900px){.ask-wrap{grid-template-columns:1fr}}\n  .ask-thread{min-height:220px;max-height:52vh;overflow:auto;padding-right:4px}\n  .ask-msg{max-width:80%;border-radius:12px;padding:10px 14px;margin:9px 0;\n    font-size:12.8px;line-height:1.55}\n  .ask-msg.me{background:var(--blue);color:#fff;margin-left:auto;border-bottom-right-radius:4px}\n  .ask-msg.ai{background:var(--surface);border:1px solid var(--line);color:var(--ink2);\n    border-bottom-left-radius:4px}\n  .ask-msg.ai.warn{border-color:var(--amber)}\n  .ask-msg.ai.pending{opacity:.6}\n  .ask-msg .cite{color:var(--blue);font-weight:700;cursor:pointer;font-size:11px;\n    vertical-align:2px}\n  .ask-msg .gen{display:block;margin-top:7px;font-size:10px;color:var(--muted)}\n  .ask-form{display:flex;gap:8px;margin-top:12px}\n  .ask-form input{flex:1;font:inherit;color:var(--ink);background:var(--surface2);\n    border:1px solid var(--line);border-radius:9px;padding:9px 12px}\n  .ask-form input:focus{outline:none;border-color:var(--blue)}\n  .ask-src{background:var(--surface);border:1px solid var(--line);border-radius:11px;\n    padding:12px 14px}\n  .ask-src h4{font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;\n    color:var(--muted);margin-bottom:8px}\n  .ask-src .s{font-size:11.5px;padding:6px 0;border-bottom:1px solid var(--line);line-height:1.45}\n  .ask-src .s:last-child{border-bottom:0}\n  .ask-src .s b{color:var(--blue)}\n  .ask-src .s a{font-size:10.5px}\n  .ask-sug{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0 2px}\n  .ask-sug button{border:1px solid var(--line);border-radius:999px;padding:4px 11px;\n    font-size:11.5px;color:var(--ink2);background:var(--surface)}\n  .ask-sug button:hover{border-color:var(--blue);color:var(--blue)}\n\n  /* ── compact SaaS density pass ──\n     The content was right but the page was loud: oversized type, tall rows and\n     long scrolls where a glance should do. Sections cap their height and scroll\n     inside themselves, so a page fits a screen and the eye stays put. */\n  .page{max-width:1400px;padding:14px 20px 40px}\n  h3.sec{margin:12px 0 6px;font-size:10.5px}\n  .tiles,.xtiles{gap:8px;margin-bottom:12px}\n  .tile{padding:8px 11px}\n  .tile b{font-size:17px}\n  .tile span{font-size:10.5px}\n  .card,.xcard,.hsec,.simple-card{padding:12px 14px;margin-bottom:10px;border-radius:10px}\n  .xcard h3,.hsec h3{margin-bottom:8px}\n  table{font-size:11.5px}\n  th{padding:4px 7px}\n  td{padding:5px 7px}\n  .ptitle{font-size:15px;margin:0 0 2px}\n  .psub{font-size:11.5px;margin-bottom:10px}\n  .xhero,.md-head b,.dk-hero b{font-size:16px}\n  .xsub{font-size:12px;margin-bottom:12px}\n  .md-lede{font-size:13px;margin:8px 0 12px}\n  .md-ev{padding:7px 11px;margin:5px 0}\n  .md-ev b{font-size:12.5px}\n  .story{padding:5px 0}\n  .fbar{gap:5px;margin-bottom:8px}\n  .fbar select,.fbar input{padding:3px 8px;font-size:11.5px}\n  /* long lists scroll inside their own box instead of stretching the page */\n  .scrollbox{max-height:340px;overflow:auto}\n  .scrollbox.short{max-height:230px}\n  .halfgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}\n  @media(max-width:1000px){.halfgrid{grid-template-columns:1fr}}\n  /* ── brand + slim header ── */\n  .top{height:46px;padding:0 16px;gap:10px}\n  .brand{font-size:12.5px;gap:7px;font-weight:700;letter-spacing:-.01em}\n  .brand .logo{width:21px;height:21px;font-size:10px;border-radius:6px}\n  .brand small{display:block;font-size:9px;color:var(--muted);font-weight:400;\n    letter-spacing:.02em;margin-top:-1px}\n  .nav button{padding:5px 11px;font-size:12px}\n  .top .mini{font-size:10.5px;padding:2px 8px;border-radius:6px}\n  .lanebar{top:46px;height:36px;padding:0 16px}\n  .lanebar button{padding:4px 10px;font-size:12px}\n  .lanebar .who{font-size:12px;margin-right:10px}\n  /* ── chat as a collapsible left panel ── */\n  .chatdock{position:fixed;left:0;top:46px;bottom:0;width:0;background:var(--surface);\n    border-right:1px solid var(--line);z-index:28;overflow:hidden;transition:width .16s ease}\n  .chatdock.open{width:390px}\n  @media(max-width:900px){.chatdock.open{width:100%}}\n  .chatdock .inner{width:390px;max-width:100vw;height:100%;display:flex;flex-direction:column;\n    padding:12px 14px}\n  @media(max-width:900px){.chatdock .inner{width:100%}}\n  .chatdock h3{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);\n    display:flex;align-items:center;gap:8px;margin-bottom:8px}\n  .chatdock h3 .x{margin-left:auto;cursor:pointer;color:var(--muted);font-size:14px}\n  .chattoggle{position:fixed;left:0;bottom:18px;z-index:29;border:1px solid var(--line);\n    border-left:0;border-radius:0 9px 9px 0;background:var(--blue);color:#fff;\n    padding:9px 12px;font-size:12px;font-weight:650;cursor:pointer;box-shadow:var(--shadow)}\n  .chattoggle.shifted{left:390px}\n  @media(max-width:900px){.chattoggle.shifted{left:auto;right:14px}}\n  body.chatopen .page{margin-left:390px}\n  @media(max-width:900px){body.chatopen .page{margin-left:0}}\n  .ctxtoggle{display:flex;align-items:center;gap:6px;font-size:10.5px;color:var(--muted);\n    margin-bottom:8px}\n  .ctxtoggle button{border:1px solid var(--line);border-radius:999px;padding:2px 9px;\n    font-size:10.5px;color:var(--ink2);background:var(--surface2)}\n  .ctxtoggle button.on{background:var(--blue);border-color:var(--blue);color:#fff}\n"],"\n"],"\n",["BODY",{},"\n",["DIV",{"class":"top"},"\n  ",["DIV",{"class":"brand"},["DIV",{"class":"logo"},"R"],["SPAN",{},"riskGPT",["SMALL",{},"financial web data aggregator"]]],"\n  ",["DIV",{"class":"nav"},"\n    ",["BUTTON",{"class":"on","id":"nHome","onclick":""},"Home"],"\n    ",["BUTTON",{"id":"nOvw","onclick":""},"🏛️ Regulatory"],"\n    ",["BUTTON",{"id":"nNews","onclick":""},"📰 Financial News"],"\n    ",["BUTTON",{"id":"nHea","onclick":""},"Health"],"\n  "],"\n  ",["DIV",{"class":"spacer"}],"\n  ",["LABEL",{"style":"color:var(--muted);font-size:12px"},"Window\n    ",["SELECT",{"id":"days","onchange":""},["OPTION",{"__playwright_selected_":"true"},"7"],["OPTION",{"__playwright_selected_":"false"},"14"],["OPTION",{"__playwright_selected_":"false"},"30"]],"\n  "],"\n  ",["SPAN",{"class":"pill ok mini","id":"integrity"},"…"],"\n  ",["SPAN",{"id":"whoami"}],"\n"],"\n\n",["DIV",{"id":"authGate"},"\n  ",["DIV",{"class":"authbox"},"\n    ",["H2",{"id":"authTitle"},"Sign in"],"\n    ",["DIV",{"class":"sub","id":"authSub"},"Market & Regulatory Intelligence — on-prem."],"\n    ",["LABEL",{"for":"authName","id":"authNameLabel","style":"display:none"},"Your name"],"\n    ",["INPUT",{"__playwright_value_":"","id":"authName","placeholder":"Credit Oversight","style":"display:none","autocomplete":"name"}],"\n    ",["LAB