"id":"xhDate"},"live production data"],"\n    ",["DIV",{"class":"xhero"},"Market & Regulatory Intelligence"],"\n    ",["DIV",{"class":"xsub"},"This platform watches two things every day so you don't have to:\n      ",["B",{},"what financial regulators publish"],", and ",["B",{},"what the financial press is reporting"],".\n      Everything is collected automatically, kept with full history, and ordered by how much it\n      matters to credit risk — not by how recent it is."],"\n    ",["DIV",{"class":"intro","id":"introHome"},"\n      ",["SPAN",{},"👋"],"\n      ",["SPAN",{},["B",{},"New here?"]," Start with one of the two lanes below. Each opens a summary page,\n        and its own menu bar appears at the top with everything inside that lane —\n        the sources it watches, the documents it holds, what changed recently, and how collection is running.\n        Every chart is clickable: clicking a bar takes you to the documents behind it."],"\n      ",["SPAN",{"class":"x","onclick":"","title":"dismiss"},"×"],"\n    "],"\n    ",["DIV",{"class":"xtiles","id":"xhTiles"}],"\n    ",["DIV",{"class":"lanes","id":"xhLanes"}],"\n    ",["DIV",{"class":"xgrid"},"\n      ",["DIV",{"class":"xcard"},["H3",{"id":"xhRegionsHead"},"Corpus by coverage area"],"\n        ",["DIV",{"id":"xhRegions","class":"empty"},"loading…"],"\n        ",["DIV",{"class":"xnote"},"Click any area to browse its documents."]],"\n      ",["DIV",{"class":"xcard"},["H3",{},"Regulatory materiality — deterministic score"],"\n        ",["DIV",{"id":"xhBands","class":"empty"},"loading…"],"\n        ",["DIV",{"class":"xnote"},"score = doc-type base × regulator tier + topic + deadline proximity +\n          revision size. Click a band to see those documents."]],"\n    "],"\n    ",["DIV",{"class":"xcard"},["H3",{},"Where to start"],"\n      ",["DIV",{"class":"steps"},"\n        ",["DIV",{"class":"step-c"},["B",{},"1 · See what's urgent"],"\n          ",["SPAN",{},"The highest-priority regulatory documents from the last 7 days, ranked by materiality."],"\n          ",["EM",{"onclick":""},"Open the regulatory lane →"]],"\n        ",["DIV",{"class":"step-c"},["B",{},"2 · Read this morning's news"],"\n          ",["SPAN",{},"Today's stories from 25 financial wires, ordered by credit-risk relevance."],"\n          ",["EM",{"onclick":""},"Open today's stories →"]],"\n        ",["DIV",{"class":"step-c"},["B",{},"3 · Look something up"],"\n          ",["SPAN",{},"Search the full library by regulator, topic, document type, priority or date."],"\n          ",["EM",{"onclick":""},"Browse documents →"]],"\n      "]],"\n\n    ",["DIV",{"class":"xgrid"},"\n      ",["DIV",{"class":"xcard"},["H3",{},"Financial news — daily volume"],"\n        ",["DIV",{"class":"xcols","id":"xhVol"}],"\n        ",["DIV",{"class":"xnote"},"Click a day to open that day's ranked story feed."]],"\n      ",["DIV",{"class":"xcard"},["H3",{},"Operational footprint"],"\n        ",["DIV",{"id":"xhOps"}]],"\n    "],"\n  "],"\n\n  ",["DIV",{"class":"view","id":"v-ovw"},"\n    ",["DIV",{"class":"xdate","id":"xrDate"},"live production data"],"\n    ",["DIV",{"class":"xhero"},"🏛️ Regulatory Intelligence"],"\n    ",["DIV",{"class":"xsub"},"Binding rules, guidance, consultations and enforcement from\n      ",["B",{"id":"xrCount"},"30 regulators"]," — versioned in an append-only archive, diffed\n      line-by-line, and ranked by materiality."],"\n    ",["DIV",{"class":"xtiles","id":"xrTiles"}],"\n    ",["DIV",{"class":"xgrid"},"\n      ",["DIV",{"class":"xcard"},["H3",{},"Deepest holdings ",["SPAN",{"class":"plain","id":"xrLeagueSub"}]],"\n        ",["DIV",{"class":"xlegend"},["SPAN",{},["I",{"style":"background:var(--blue)"}],"documents"],"\n          ",["SPAN",{},["I",{"style":"background:var(--muted)"}],"of which policy PDFs"]],"\n        ",["DIV",{"id":"xrLeague","class":"empty"},"loading…"],"\n        ",["DIV",{"class":"xnote","id":"xrLeagueNote"}]],"\n      ",["DIV",{"class":"xcard"},["H3",{},"What the corpus contains — b