{
  "name": "corpus_list_files",
  "implementation": "sajha.tools.impl.corpus_tools.CorpusListFilesTool",
  "description": "List the markdown documents held, with filters. The directory listing of the corpus: filter by source, doc_type, stage (web|policy), publication date or title text.",
  "version": "1.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "source": {
        "type": [
          "string",
          "array"
        ],
        "items": {
          "type": "string"
        },
        "description": "Source id(s), e.g. osfi, nikkei_asia"
      },
      "doc_type": {
        "type": [
          "string",
          "array"
        ],
        "items": {
          "type": "string"
        },
        "description": "guidance, final_rule, news_story, announcement, consultation, report"
      },
      "stage": {
        "type": "string",
        "enum": [
          "web",
          "policy"
        ],
        "description": "web = HTML-derived, policy = PDF-derived"
      },
      "date_from": {
        "type": "string",
        "description": "YYYY-MM-DD"
      },
      "date_to": {
        "type": "string",
        "description": "YYYY-MM-DD"
      },
      "title_contains": {
        "type": "string"
      },
      "limit": {
        "type": "integer",
        "default": 50
      },
      "offset": {
        "type": "integer",
        "default": 0
      }
    },
    "required": []
  },
  "outputSchema": {
    "type": "object"
  },
  "metadata": {
    "author": "regagg",
    "category": "Corpus Retrieval",
    "tags": [
      "corpus",
      "markdown",
      "retrieval",
      "riskgpt"
    ],
    "cacheTTL": 120,
    "readOnly": true
  }
}
