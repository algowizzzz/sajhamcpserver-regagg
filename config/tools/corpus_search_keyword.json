{
  "name": "corpus_search_keyword",
  "implementation": "sajha.tools.impl.corpus_tools.CorpusKeywordSearchTool",
  "description": "Exact keyword search over titles and bodies. Best for rule numbers, tickers and precise phrases.",
  "version": "1.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "source": {
        "type": [
          "string",
          "array"
        ],
        "items": {
          "type": "string"
        }
      },
      "doc_type": {
        "type": [
          "string",
          "array"
        ],
        "items": {
          "type": "string"
        }
      },
      "date_from": {
        "type": "string"
      },
      "date_to": {
        "type": "string"
      },
      "limit": {
        "type": "integer",
        "default": 20
      }
    },
    "required": [
      "query"
    ]
  },
  "outputSchema": {
    "type": "object"
  },
  "metadata": {
    "author": "regagg",
    "category": "Corpus Retrieval",
    "tags": [
      "corpus",
      "markdown",
      "retrieval",
      "riskgpt"
    ],
    "cacheTTL": 120,
    "readOnly": true
  }
}
