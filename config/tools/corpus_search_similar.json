{
  "name": "corpus_search_similar",
  "implementation": "sajha.tools.impl.corpus_tools.CorpusSimilarTool",
  "description": "Find documents similar to a given document or passage (TF-IDF cosine). Use to widen from one good hit to the rest of the story.",
  "version": "1.0.0",
  "enabled": true,
  "inputSchema": {
    "type": "object",
    "properties": {
      "doc_id": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "source": {
        "type": [
          "string",
          "array"
        ],
        "items": {
          "type": "string"
        }
      },
      "limit": {
        "type": "integer",
        "default": 10
      },
      "doc_type": {
        "description": "Restrict to one or more document types (e.g. 'guidance', 'final_rule', 'news_story').",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "stage": {
        "type": "string",
        "enum": [
          "web",
          "policy"
        ],
        "description": "'policy' is parsed PDF/rule text; 'web' is collected pages."
      },
      "date_from": {
        "type": "string",
        "description": "Published on or after, YYYY-MM-DD."
      },
      "date_to": {
        "type": "string",
        "description": "Published on or before, YYYY-MM-DD."
      },
      "title_contains": {
        "type": "string",
        "description": "Case-insensitive substring of the title."
      }
    },
    "required": []
  },
  "outputSchema": {
    "type": "object"
  },
  "metadata": {
    "author": "regagg",
    "category": "Corpus Retrieval",
    "tags": [
      "corpus",
      "markdown",
      "retrieval",
      "riskgpt"
    ],
    "cacheTTL": 120,
    "readOnly": true
  }
}
